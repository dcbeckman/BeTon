# Build artifacts. `out/` holds .hpkg files, `out-repo/` the assembled
# repository (index + a copy of the packages). Both are regenerated by
# build-package.sh / build-repo.sh and must never be committed -- out-repo/
# in particular contains the published index, and a stale committed copy is
# exactly the kind of thing that gets published by mistake.
out/
out-repo/
.stage-*/
